# OpenWorld Environment Configuration

# API
OPENWORLD_API_HOST=0.0.0.0
OPENWORLD_API_PORT=8000
OPENWORLD_API_URL=http://localhost:8000

# Database — PostgreSQL for persistence (SQLite OK for quick local demo)
# OPENWORLD_DATABASE_URL=postgresql://openworld:YOUR_LOCAL_DEV_PASSWORD@localhost:5432/openworld
# OPENWORLD_DATABASE_URL=sqlite:///./openworld.db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: pre-set a demo JWT instead of fetching from /auth/demo-agents
# NEXT_PUBLIC_DEMO_TOKEN=

# Security — NEVER commit real secrets (minimum 32 bytes for HS256)
OPENWORLD_SECRET_KEY=replace-with-your-own-32-plus-character-development-secret
OPENWORLD_DEMO_MODE=true

# JWT
OPENWORLD_JWT_ALGORITHM=HS256
OPENWORLD_JWT_ISSUER=openworld
OPENWORLD_JWT_AUDIENCE=openworld-agents
OPENWORLD_JWT_EXPIRE_MINUTES=60

# Policy: default-deny in production (demo_mode=true overrides to allow-unmatched)
OPENWORLD_POLICY_DEFAULT_DENY=true

# Logging
OPENWORLD_LOG_LEVEL=INFO
OPENWORLD_ENVIRONMENT=local
# OPENWORLD_DB_POOL_SIZE=5
# OPENWORLD_DB_MAX_OVERFLOW=10

# Gateway bounds (bytes)
# OPENWORLD_MAX_REQUEST_BYTES=1048576
# OPENWORLD_MAX_RESPONSE_BYTES=10485760

# GitHub issue connector — disabled by default.
# Live GitHub issue creation is NOT verified unless enabled AND a real API call succeeds.
# OPENWORLD_GITHUB_ENABLED=false
# OPENWORLD_GITHUB_TOKEN=
# OPENWORLD_GITHUB_OWNER=
# OPENWORLD_GITHUB_REPO=
# OPENWORLD_RATE_LIMIT_PER_MINUTE=0
# OPENWORLD_AUDIT_RETENTION_DAYS=90
