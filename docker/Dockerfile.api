FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml .
RUN pip install --no-cache-dir .

COPY core/ core/
COPY apps/ apps/
COPY packages/ packages/

ENV OPENWORLD_DEMO_MODE=true
ENV OPENWORLD_API_HOST=0.0.0.0
ENV OPENWORLD_API_PORT=8000

EXPOSE 8000

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
