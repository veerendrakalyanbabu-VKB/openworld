FROM python:3.12-slim

WORKDIR /app

RUN adduser --disabled-password --gecos "" --uid 10001 appuser

COPY pyproject.toml alembic.ini ./
COPY alembic/ alembic/
COPY core/ core/
COPY apps/ apps/
COPY packages/ packages/

RUN pip install --no-cache-dir . \
    && chown -R appuser:appuser /app

USER appuser

ENV OPENWORLD_API_HOST=0.0.0.0
ENV OPENWORLD_API_PORT=8000
# Runtime must set OPENWORLD_DATABASE_URL, OPENWORLD_SECRET_KEY, OPENWORLD_DEMO_MODE.

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=4)"

CMD ["sh", "-c", "python -m uvicorn apps.api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
