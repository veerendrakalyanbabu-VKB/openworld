# Copy to an untracked file (for example .env.production) and fill in real values.
# NEVER commit real secrets.

OPENWORLD_ENVIRONMENT=production
OPENWORLD_DEMO_MODE=false
OPENWORLD_POLICY_DEFAULT_DENY=true
OPENWORLD_DATABASE_URL=postgresql://openworld:CHANGE_ME@127.0.0.1:5432/openworld
OPENWORLD_SECRET_KEY=replace-with-your-own-32-plus-character-production-secret
OPENWORLD_CORS_ORIGINS=["https://your-frontend.example"]
OPENWORLD_JWT_ISSUER=openworld
OPENWORLD_JWT_AUDIENCE=openworld-agents
NEXT_PUBLIC_API_URL=https://api.your-domain.example
